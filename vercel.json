{
  "functions": {
    "api/send-participant-email.js": {
      "includeFiles": "{participant-documents,email-templates}/**"
    },
    "api/lead-submit.js": {
      "includeFiles": "email-templates/**"
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "thehealthwellbeinghub.com"
        }
      ],
      "destination": "https://www.thehealthwellbeinghub.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "https://hub-command-centre.vercel.app/dashboard"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "https://hub-command-centre.vercel.app/dashboard/:path*"
    }
  ],
  "headers": [
    {
      "source": "/email-templates/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/staff/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/dashboard",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/dashboard/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/docs/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/participant-documents/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}

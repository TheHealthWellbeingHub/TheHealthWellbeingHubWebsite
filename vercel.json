{
  "functions": {
    "api/send-participant-email.js": {
      "includeFiles": "{participant-documents,staff-documents,email-templates}/**",
      "maxDuration": 60
    },
    "api/lead-submit.js": {
      "includeFiles": "email-templates/**"
    },
    "api/send-document-pack.js": {
      "includeFiles": "{participant-documents,staff-documents}/**",
      "maxDuration": 60
    },
    "api/weekly-invoice-draft.js": {
      "maxDuration": 60
    },
    "api/xero.js": {
      "maxDuration": 60
    },
    "api/social.js": {
      "includeFiles": "api/_social/**"
    }
  },
  "crons": [
    {
      "path": "/api/weekly-invoice-draft",
      "schedule": "0 22 * * 0"
    },
    {
      "path": "/api/sc-monthly-invoice-draft",
      "schedule": "0 22 28-31 * *"
    }
  ],
  "redirects": [
    {
      "source": "/ndis-check",
      "destination": "/ndis-eligibility-checker/",
      "permanent": true
    },
    {
      "source": "/ndis-check/",
      "destination": "/ndis-eligibility-checker/",
      "permanent": true
    },
    {
      "source": "/staff-documents/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/api/_social/:path*",
      "destination": "/socialmedia",
      "permanent": false
    },
    {
      "source": "/participant-documents/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "thehealthwellbeinghub.com"
        }
      ],
      "destination": "https://www.thehealthwellbeinghub.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/xero-status",
      "destination": "/api/xero?action=status"
    },
    {
      "source": "/socialmedia",
      "destination": "/api/social"
    },
    {
      "source": "/socialmedia/",
      "destination": "/api/social"
    },
    {
      "source": "/api/sc-monthly-invoice-draft",
      "destination": "/api/xero?action=sc-monthly"
    },
    {
      "source": "/dashboard",
      "destination": "https://hub-command-centre.vercel.app/dashboard"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "https://hub-command-centre.vercel.app/dashboard/:path*"
    }
  ],
  "headers": [
    {
      "source": "/email-templates/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/staff/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/dashboard",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/dashboard/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/docs/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/participant-documents/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/socialmedia",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/_social/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
